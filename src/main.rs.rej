+
+        tracing::warn!(
+            schema = %schema_path,
+            root   = %orchard_root,
+            "MAILROOM_GENERATE_SCHEMA set — regenerating schema tree \
+             (destructive: not yet merge-safe against hand-edited nest files)"
+        );
+        schema::generate_fresh_tree(Path::new(&schema_path), Path::new(&orchard_root))?;
